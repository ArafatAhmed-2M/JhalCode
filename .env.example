# Copy to .env (or just run `jcc` then `/connect` — recommended)
JHAL_API_KEY=sk-your-opencode-zen-key
JHAL_BASE_URL=https://opencode.ai/zen/v1
JHAL_MODEL=ling-3.0-flash-fin-free
JHAL_MODELS=ling-3.0-flash-fin-free,nemotron-3.5-lightning-free,nemotron-3-ultra-free
# JHAL_AUTO=0
# JHAL_MAX_STEPS=30
# Local model example (Ollama):
# JHAL_BASE_URL=http://localhost:11434/v1
# JHAL_MODEL=qwen2.5:7b
# JHAL_API_KEY=ollama
